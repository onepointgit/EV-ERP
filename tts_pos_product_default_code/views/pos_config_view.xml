<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tts_pos_product_default_code</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pos_print_product_default_code_receipt" help="Display the internal product reference on the point of sale receipt">
                    <field name="pos_print_product_default_code_receipt" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>