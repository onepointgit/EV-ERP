<odoo>
    <data>

        <record id="property_sub_type_view_tree" model="ir.ui.view">
            <field name="name">property.sub.type.view.tree</field>
            <field name="model">property.sub.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="pp_type"/>
                    <field name="type"/>
                </list>
            </field>
        </record>

        <record id="property_sub_type_action" model="ir.actions.act_window">
            <field name="name">Property Sub-Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">property.sub.type</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No sub category found ! Let's create one
                </p>
            </field>
        </record>



        <menuitem id="property_config_menu"
                  name="Configuration"
                  parent="ev_compound_menu"
                  sequence="20"/>


        <menuitem id="property_sub_type_menu"
                  name="Property Sub-Category"
                  action="property_sub_type_action"
                  parent="property_config_menu"
                  sequence="10"/>


    </data>
</odoo>
