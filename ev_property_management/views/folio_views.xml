<odoo>
    <data>

        <record id="unit_folio_view_tree" model="ir.ui.view">
            <field name="name">unit.folio.view.tree</field>
            <field name="model">unit.folio</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="check_in_date"/>
                    <field name="check_out_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="unit_folio_view_form" model="ir.ui.view">
            <field name="name">unit.folio.view.form</field>
            <field name="model">unit.folio</field>
            <field name="arch" type="xml">
                <form string="Folio">
                    <header>
                        <button name="button_confirm" type="object" invisible="state != 'checked_in'" string="Confirm"
                                class="oe_highlight"
                                data-hotkey="q"/>
                        <button name="button_set_to_draft" type="object" invisible="state != 'cancel'"
                                string="Set to Draft" class="btn-primary"
                                data-hotkey="y"/>
                        <button name="button_checked_out" type="object" invisible="state not in ('in_progress')"
                                string="Check-in" class="btn-primary"
                                data-hotkey="m"/>
                        <button name="button_done" type="object" invisible="state not in ('checked_out')"
                                string="Check-in" class="btn-primary"
                                data-hotkey="m"/>
                        <button name="button_cancel" type="object"
                                invisible="state in ('checked_in')"
                                string="Cancel" class="btn-secondary"
                                data-hotkey="x"/>
                        <field name="state" widget="statusbar" readonly="1" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="reservation_id"/>
                                <field name="partner_id"/>
                                <field name="partner_phone"/>
                                <field name="partner_email"/>
                                <field name="currency_id"/>
                                <field name="price_list_id"/>
                            </group>
                            <group string="Booking Details">
                                <field name="check_in_date"/>
                                <field name="check_out_date"/>
                                <field name="no_of_adults"/>
                                <field name="no_of_children"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Room Details">
                                <field name="room_line_ids">
                                    <list editable="bottom">
                                        <field name="unit_type_id"/>
                                        <field name="unit_id"/>
                                        <field name="uom_qty"/>
                                        <field name="currency_id" optional="hide"/>
                                        <field name="price_unit" readonly="0"/>
                                        <field name="tax_ids" readonly="0" widget="many2many_tags"/>
                                        <field name="price_sub_total" optional="hide"/>
                                        <field name="price_tax" optional="hide"/>
                                        <field name="price_total"/>
                                    </list>
                                </field>
                                <group colspan="2"
                                       class="oe_subtotal_footer oe_right">
                                    <field name="folio_subtotal"
                                           sum="Untaxed amount" widget="monetary"/>
                                    <field name="folio_tax_price" widget="monetary"/>
                                    <label for="folio_total"/>
                                    <field name="folio_total" nolabel="1"
                                           sum="Total amount" widget="monetary"/>
                                </group>
                                <div class="oe_clear"/>
                            </page>
                            <page string="Guest Document">
                                <field name="guest_line_ids">
                                    <list>
                                        <field name="unit_id"/>
                                        <field name="document_id"/>
                                        <field name="document_type_id"/>
                                        <field name="valid_from"/>
                                        <field name="valid_to"/>
                                        <field name="guest_name"/>
                                        <field name="gender"/>
                                        <field name="date_of_birth"/>
                                        <field name="country"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Services">
                                <field name="service_line_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="name"/>
                                        <field name="uom_qty"/>
                                        <field name="price_unit"/>
                                        <field name="tax_ids" widget="many2many_tags"/>
                                        <field name="price_sub_total" optional="hide"/>
                                        <field name="price_tax" optional="hide"/>
                                        <field name="price_total"/>
                                    </list>
                                </field>
                            </page>
                            <page string="POS">
                                <field name="pos_order_line_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="unit_folio_action" model="ir.actions.act_window">
            <field name="name">Folio</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">unit.folio</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    No Folio found ! Let's create one
                </p>
            </field>
        </record>



        <menuitem id="unit_folio_menu"
                  name="Folio"
                  action="unit_folio_action"
                  parent="transaction_menu"
                  sequence="10"/>


    </data>
</odoo>
