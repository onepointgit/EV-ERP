<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Sequences for reservation requests -->
        <record id="ir_sequence_unit_reservation" model="ir.sequence">
            <field name="name">Reservation</field>
            <field name="code">reservation.ref</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ir_sequence_unit_folio" model="ir.sequence">
            <field name="name">Folio</field>
            <field name="code">unit.folio</field>
            <field name="prefix">HFL/%(year)s</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>